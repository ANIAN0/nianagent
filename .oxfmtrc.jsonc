{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortTailwindcss": {
    "stylesheet": "src/index.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "dist",
    "src-tauri/runtime",
    "src-tauri/target",
    ".dev",
    "apps/workbench/.next",
    "apps/workbench/.dev",
    "apps/workbench/.releases",
    "node_modules",
    "pnpm-lock.yaml",
    "coverage"
  ]
}
