    "marked": "18.0.11",
    "parse-entities": "4.0.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-react": "^6",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "vite": "^8"
  }
