{
  "id": "opencli",
  "name": "OpenCLI",
  "description": "让Agent调用网站命令和通用浏览器操作，复用已有浏览器登录环境。",
  "version": "0.2.0",
  "apiVersion": 1,
  "defaultEnabled": false,
  "entries": {
    "app": "host.mjs",
    "pi": "pi.mjs",
    "web": "web.tsx"
  },
  "defaultConfiguration": {
    "profile": "",
    "background": false
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "profile": {
        "type": "string",
        "title": "Browser Bridge连接ID或别名",
        "description": "选择实际在线连接；失联不会自动换浏览器。"
      },
      "background": {
        "type": "boolean",
        "title": "使用上游后台窗口模式"
      }
    },
    "required": ["profile", "background"],
    "additionalProperties": false
  },
  "contributions": [
    {
      "id": "browser",
      "kind": "page",
      "title": "浏览器连接",
      "version": 1,
      "remote": false
    }
  ],
  "effects": [
    "执行OpenCLI网站命令，读取、下载或操作网站内容",
    "通过Browser Bridge使用已登录浏览器，打开网页、点击、填写及截图",
    "按用户操作安装或升级全局OpenCLI、启动或停止后台进程"
  ]
}
