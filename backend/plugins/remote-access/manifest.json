{
  "id": "remote-access",
  "name": "远程访问",
  "description": "通过扫码或链接，从网页连接正在运行的本机Moon。",
  "version": "0.2.0",
  "apiVersion": 1,
  "defaultEnabled": false,
  "entries": {
    "app": "host.mjs",
    "web": "web.tsx"
  },
  "defaultConfiguration": {
    "origin": "http://127.0.0.1:3000"
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "origin": {
        "type": "string",
        "title": "evework网页地址",
        "description": "公网使用HTTPS；本地联调可使用127.0.0.1的HTTP地址。"
      }
    },
    "required": [
      "origin"
    ],
    "additionalProperties": false
  },
  "contributions": [
    {
      "id": "remote",
      "kind": "page",
      "title": "远程访问",
      "version": 1,
      "remote": false
    }
  ],
  "effects": [
    "连接evework中继并维持本机远程访问后台",
    "持有连接链接的远程客户端可以读取会话、发送消息、停止运行和回答审批",
    "远程客户端可在允许接口内选择工作区、读取文件和上传材料",
    "重置连接会使已有连接链接失效"
  ]
}
