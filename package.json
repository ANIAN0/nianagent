{
  "name": "moon",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm workbench:build && pnpm contract:check && pnpm typecheck && node scripts/build-frontend.mjs",
    "lint": "node scripts/project-index.mjs && oxlint . && eslint .",
    "format": "oxfmt src backend scripts devtools && cargo fmt --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path scripts/release-verifier/Cargo.toml",
    "format:check": "oxfmt --check src backend scripts devtools",
    "typecheck": "tsc -b --pretty false && tsc -p backend/tsconfig.json --pretty false && pnpm --filter @moon/workbench typecheck",
    "preview": "vite preview",
    "workbench:build": "pnpm --filter @moon/workbench build",
    "notes:build": "pnpm --filter @moon/workbench build",
    "backend:package": "node scripts/package-backend.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "release:version": "node scripts/release-version.mjs",
    "release:check": "node scripts/release-version.mjs --check",
    "release:prepare": "node scripts/prepare-desktop-release.mjs",
    "release:verify": "node scripts/verify-release-assets.mjs",
    "contract:generate": "node scripts/generate-model-contract.mjs && node scripts/generate-desktop-contract.mjs",
    "boundary:check": "node scripts/check-module-boundaries.mjs",
    "contract:check": "node scripts/generate-model-contract.mjs --check && node scripts/generate-desktop-contract.mjs --check && node scripts/api-documentation.mjs --check"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-mcp": "1.6.0",
    "@lexical/history": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@pierre/diffs": "1.5.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/api": "^2.12.5",
    "buffer": "6.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "katex": "0.19.1",
    "lexical": "0.49.0",
    "lucide-react": "^1.49.0",
    "noise-handshake": "4.2.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "shadcn": "4.23.0",
    "shiki": "4.5.0",
    "sodium-javascript": "0.8.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/browser": "^4.3.3",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^24",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sucrase": "^3.35.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
