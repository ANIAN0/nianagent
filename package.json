{
  "name": "moon",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-model-contract.mjs --check && tsc -b && node scripts/build-frontend.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "backend:package": "node scripts/package-backend.mjs",
    "desktop:build": "pnpm tauri build --config src-tauri/tauri.production.conf.json",
    "contract:generate": "node scripts/generate-model-contract.mjs",
    "contract:check": "node scripts/generate-model-contract.mjs --check"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-mcp": "1.0.0",
    "@lexical/history": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/api": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lexical": "0.49.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
